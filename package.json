{
  "name": "no-nepali-profanity",
  "version": "0.1.0",
  "description": "Profanity matcher for English, Romanized Nepali and Devanagari Nepali: leetspeak, stretched and spelled-out letters, Nepali postpositions, with care not to block real names.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": ["profanity", "filter", "nepali", "devanagari", "moderation", "bad-words"],
  "author": "PG-Momik",
  "license": "MIT",
  "homepage": "https://mukhxadnahunna.com/js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PG-Momik/no-nepali-profanity.git"
  },
  "bugs": "https://github.com/PG-Momik/no-nepali-profanity/issues",
  "engines": { "node": ">=18" },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
